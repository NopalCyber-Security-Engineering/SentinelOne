    "s1ql": "\"(\n  event.category = 'Process'\n  AND event.type = 'Process Creation'\n  AND endpoint.os.process.name = 'windows'\n)\nAND\n(\n  (\n    (\n      src.process.commandLine contains:anycase 'mshta'\n      OR src.process.commandLine contains:anycase 'mshta.exe'\n    )\n    AND src.process.commandLine ILIKE 'http'\n  )\n  OR\n  (\n    (\n      tgt.process.cmdline contains:anycase 'mshta'\n      OR tgt.process.cmdline contains:anycase 'mshta.exe'\n    )\n    AND tgt.process.cmdline ILIKE 'http'\n  )\n)\"\n",
